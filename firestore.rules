rules_version = '2';

// Your current rules, plus two new blocks for the PreCenter remote:
//   presenter     - what the computer is showing right now (the computer
//                   writes it, the phone reads it)
//   presenterCmd  - button presses sent from the phone to the computer
// Both are limited to members of that team (teams/{teamId}.memberUids).
// Paste into Firebase Console -> Build -> Firestore Database -> Rules,
// then click Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // True when the signed-in user is on this team.
    function isTeamMember(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids;
    }

    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    match /libraries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /lineups/{docId} {
      allow read, write: if request.auth != null;
    }

    match /videoArchive/{docId} {
      allow read, write: if request.auth != null;
    }

    // Team Activity bell (one doc per team: activity/{teamId})
    match /activity/{docId} {
      allow read, write: if request.auth != null;
    }

    // NEW: PreCenter remote - live state (one doc per team)
    match /presenter/{teamId} {
      allow read, write: if isTeamMember(teamId);
    }

    // NEW: PreCenter remote - button presses from the phone
    match /presenterCmd/{teamId}/q/{cmdId} {
      allow read, write: if isTeamMember(teamId);
    }

    // Shared lineup links: signed-in users can create / update / turn off a
    // link, but nobody can read or list them from the app. The public page
    // reads them through /api/lineup-share instead.
    match /lineupShares/{token} {
      allow get, list: if false;
      allow create, update, delete: if request.auth != null;
    }

    match /profiles/{uid} {

      allow write: if request.auth != null && request.auth.uid == uid;

      // Read your own profile, or a teammate's — same team is
      // decided by comparing your own profile's teamId (looked up
      // here, not trusted from the request) against theirs. If your
      // own profile doc doesn't exist yet, exists() fails this
      // safely (denies) rather than erroring.
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.teamId == resource.data.teamId
        )
      );

    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
