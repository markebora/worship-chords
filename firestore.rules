rules_version = '2';

// Paste this into Firebase Console → Build → Firestore Database
// → Rules, then click Publish.
//
// Only signed-in users (your ~10 team members, via Email/Password
// auth) can read or write anything at all, and the only thing
// they can touch is the single shared "libraries/shared" document
// that index.html reads/writes (SYNC_LIBRARY_DOC_ID). Everything
// else is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /libraries/{docId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
