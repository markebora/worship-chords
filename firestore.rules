rules_version = '2';

// Your original rules, plus one new block (activity) for the
// Team Activity bell. Paste into Firebase Console -> Build ->
// Firestore Database -> Rules, then click Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    match /libraries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /lineups/{docId} {
      allow read, write: if request.auth != null;
    }

    match /videoArchive/{docId} {
      allow read, write: if request.auth != null;
    }

    // NEW: Team Activity bell (one doc per team: activity/{teamId})
    match /activity/{docId} {
      allow read, write: if request.auth != null;
    }

    match /profiles/{uid} {

      allow write: if request.auth != null && request.auth.uid == uid;

      // Read your own profile, or a teammate's — same team is
      // decided by comparing your own profile's teamId (looked up
      // here, not trusted from the request) against theirs. If your
      // own profile doc doesn't exist yet, exists() fails this
      // safely (denies) rather than erroring.
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.teamId == resource.data.teamId
        )
      );

    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
